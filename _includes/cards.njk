{% macro card(post, tom="claro") %}
{%- set cat = (post.data.tags | categoriasDoPost)[0] -%}
<article class="card card-{{ tom }}">
  <p class="card-categoria"><a href="/categoria/{{ cat.slug }}/">{{ cat.rotulo }}</a></p>
  <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
  <p class="meta"><time datetime="{{ post.date | dataIso }}">{{ post.date | dataLonga }}</time></p>
  <p class="card-resumo">{{ post.content | resumo(160) }}</p>
</article>
{% endmacro %}

{% macro linhaLista(post) %}
{%- set cat = (post.data.tags | categoriasDoPost)[0] -%}
{%- set img = post.content | primeiraImagem -%}
<li class="item-lista{% if img %} com-imagem{% endif %}">
  {% if img %}<img src="{{ img }}" alt="" loading="lazy" width="160" height="160">{% endif %}
  <div>
    <p class="card-categoria"><a href="/categoria/{{ cat.slug }}/">{{ cat.rotulo }}</a></p>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="meta"><time datetime="{{ post.date | dataIso }}">{{ post.date | dataLonga }}</time></p>
    <p class="card-resumo">{{ post.content | resumo(200) }}</p>
  </div>
</li>
{% endmacro %}

{% macro paginacao(pagination) %}
{% if pagination.pages.length > 1 %}
<nav class="paginacao" aria-label="Páginas">
  {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}" rel="prev">Mais recentes</a>{% endif %}
  <span>Página {{ pagination.pageNumber + 1 }} de {{ pagination.pages.length }}</span>
  {% if pagination.href.next %}<a href="{{ pagination.href.next }}" rel="next">Mais antigas</a>{% endif %}
</nav>
{% endif %}
{% endmacro %}
