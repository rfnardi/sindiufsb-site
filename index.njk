---
layout: base.njk
title: Início
---
{% from "cards.njk" import card %}
{%- set destaque = collections.posts[0] -%}
{%- set imgDestaque = destaque.content | primeiraImagem -%}
{%- set catDestaque = (destaque.data.tags | categoriasDoPost)[0] -%}

<section class="hero" aria-roledescription="carrossel" aria-label="Fotos da SindiUFSB">
  <div class="hero-fotos">
    {%- for f in capa %}
    <figure class="hero-foto{% if loop.first %} ativa{% endif %}" style="--foto: url('{{ f.imagem | url }}'); --posicao: {{ f.posicao }};"{% if not loop.first %} aria-hidden="true"{% endif %}>
      {%- if f.legenda %}<figcaption>{{ f.legenda }}</figcaption>{% endif -%}
    </figure>
    {%- endfor %}
  </div>
  <div class="hero-interno">
    <h1>Docentes da UFSB organizados por direitos, carreira e universidade pública</h1>
    <p>A SindiUFSB é a seção sindical do ANDES-SN na UFSB. Nossa força está na participação de cada colega, nas assembleias e nos campi.</p>
    <p class="hero-acoes">
      <a class="botao botao-contorno" href="/p/composicao.html">Conheça a diretoria</a>
    </p>
  </div>
  {%- if capa.length > 1 %}
  <div class="hero-controles" hidden>
    <button type="button" class="hero-pausa" aria-label="Pausar fotos"></button>
    {%- for f in capa %}
    <button type="button" class="hero-ponto" aria-label="Foto {{ loop.index }} de {{ capa.length }}{% if f.legenda %}: {{ f.legenda }}{% endif %}"{% if loop.first %} aria-current="true"{% endif %}></button>
    {%- endfor %}
  </div>
  <script src="/assets/js/capa.js" defer></script>
  {%- endif %}
</section>

{%- if collections.proximosEventos.length %}
<section class="eventos" aria-label="Próximos eventos">
  {%- for e in collections.proximosEventos %}
  <article class="evento evento-{{ e.tipo }}" data-fim="{{ e.fim | dataIso }}">
    <p class="evento-rotulo">{{ e.rotulo }}</p>
    <h2><a href="{{ e.url }}">{{ e.titulo }}</a></h2>
    <p class="evento-quando"><time datetime="{{ e.inicio | dataIso }}">{{ e.inicio | diaDaSemana }}, {{ e.inicio | dataLonga }}</time>, {{ e.horaTexto }}</p>
    {%- if e.locais.length %}
    <ul class="evento-locais">
      {%- for l in e.locais %}<li>{{ l }}</li>{% endfor %}
    </ul>
    {%- else %}
    <p class="evento-onde">{{ e.onde }}</p>
    {%- endif %}
    <p class="evento-acoes">
      <a class="botao botao-claro" href="{{ e.url }}">{{ "Ler a convocação" if e.tipo == "assembleia" else "Saiba mais" }}</a>
      <a href="{{ e | googleAgenda }}" rel="noopener">Adicionar ao Google Agenda</a>
      <a href="/agenda/{{ e.id }}.ics" download>Outra agenda (.ics)</a>
    </p>
  </article>
  {%- endfor %}
</section>
<script src="/assets/js/eventos.js" defer></script>
{%- endif %}

<div class="colunas">
  <div class="principal">
    <header class="titulo-secao">
      <h2>Últimas notícias</h2>
      <a href="/noticias/">Ver todas as notícias</a>
    </header>

    <article class="destaque">
      <div class="destaque-texto">
        <p class="card-categoria"><a href="/categoria/{{ catDestaque.slug }}/">{{ catDestaque.rotulo }}</a></p>
        <h3><a href="{{ destaque.url }}">{{ destaque.data.title }}</a></h3>
        <p class="meta"><time datetime="{{ destaque.date | dataIso }}">{{ destaque.date | dataLonga }}</time></p>
        <p class="card-resumo">{{ destaque.content | resumo(240) }}</p>
        <a class="botao botao-claro" href="{{ destaque.url }}">Ler notícia completa</a>
      </div>
      <div class="destaque-imagem">
        {% if imgDestaque %}<img src="{{ imgDestaque }}" alt="">{% else %}
        <svg viewBox="0 0 64 64" width="96" height="96" aria-hidden="true"><rect x="14" y="8" width="36" height="48" rx="2" fill="none" stroke="currentColor" stroke-width="4"/><path d="M22 22h20M22 31h20M22 40h12" stroke="currentColor" stroke-width="4"/></svg>{% endif %}
      </div>
    </article>

    <div class="grade-cards">
      {%- for post in collections.posts.slice(1, 5) -%}
        {{ card(post, "escuro" if loop.index == 3 else "claro") }}
      {%- endfor %}
    </div>
  </div>

  {% include "lateral.njk" %}
</div>
